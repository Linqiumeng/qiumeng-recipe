# 复制为 .env 后填写。本地开发时这些都可以先不填：
# - 不填 MONGODB_URI 会自动启动一个本地内存数据库（数据存在 .data/）
# - 不填 ADMIN_PASSWORD / JWT_SECRET 会使用开发默认值（密码 admin）

# MongoDB Atlas 连接串
MONGODB_URI=

# 后台登录密码
ADMIN_PASSWORD=

# 用于签发登录凭证的随机字符串，可用 `openssl rand -hex 32` 生成
JWT_SECRET=

# Cloudinary（图片上传），在 Cloudinary 控制台 Dashboard 页可以找到
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
